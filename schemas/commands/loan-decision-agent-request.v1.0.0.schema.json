{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/commands/loan-decision-agent-request.v1.0.0.schema.json",
  "title": "Loan Decision Agent Request",
  "description": "Transport-neutral Governance request to run the Phase 2 Loan Decision Agent on fixed Snapshot/model inputs.",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "decisionCaseId": { "type": "string", "minLength": 1 },
    "evaluationRunId": { "type": "string", "format": "uuid" },
    "agentRunId": { "type": "string", "format": "uuid" },
    "agentType": { "const": "LOAN_DECISION_AGENT" },
    "requestIdempotencyKey": { "type": "string", "minLength": 16, "maxLength": 160 },
    "snapshotReference": { "$ref": "../domain/snapshot-reference.v1.0.0.schema.json" },
    "featureSchemaVersion": { "type": "string", "minLength": 1 },
    "featurePayload": { "$ref": "../domain/feature-payload.v1.0.0.schema.json" },
    "preprocessingVersion": { "type": "string", "minLength": 1 },
    "modelVersion": { "type": "string", "minLength": 1 },
    "modelArtifactDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "thresholdVersion": { "type": "string", "minLength": 1 },
    "requestedAt": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "deadlineAt": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "correlationId": { "type": "string", "minLength": 1 },
    "causationId": { "type": "string", "format": "uuid" }
  },
  "required": ["schemaVersion", "decisionCaseId", "evaluationRunId", "agentRunId", "agentType", "requestIdempotencyKey", "snapshotReference", "featureSchemaVersion", "preprocessingVersion", "modelVersion", "modelArtifactDigest", "thresholdVersion", "requestedAt", "deadlineAt", "correlationId", "causationId"],
  "allOf": [
    {
      "if": {
        "properties": {
          "snapshotReference": {
            "properties": {
              "referenceType": { "const": "MATERIALIZED_FEATURES" }
            },
            "required": ["referenceType"]
          }
        },
        "required": ["snapshotReference"]
      },
      "then": { "required": ["featurePayload"] }
    },
    {
      "if": {
        "properties": {
          "snapshotReference": {
            "properties": {
              "referenceType": { "const": "IMMUTABLE_REFERENCE" }
            },
            "required": ["referenceType"]
          }
        },
        "required": ["snapshotReference"]
      },
      "then": { "not": { "required": ["featurePayload"] } }
    }
  ],
  "additionalProperties": false
}
