{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/commands/loan-decision-command.v1.0.0.schema.json",
  "title": "Loan Decision Command v1.0.0",
  "description": "Domain payload shared by loan.decision.commanded.v1 Schema 1.0.0. The containing Event selects its version; the Phase 1 Profile requires reasonCodes, issuedAt, and business idempotencyKey. Event eventId remains the transport deduplication key. APPROVE and REJECT are the only executable Phase 1 outcomes.",
  "type": "object",
  "properties": {
    "commandId": { "type": "string", "format": "uuid" },
    "decisionCaseId": { "type": "string", "minLength": 1 },
    "applicationId": { "type": "string", "minLength": 1 },
    "decisionId": { "type": "string", "format": "uuid" },
    "evaluationRunId": { "type": "string", "format": "uuid" },
    "evaluationRunStatus": { "const": "COMPLETED" },
    "finalDecision": { "type": "string", "enum": ["APPROVE", "REJECT"] },
    "assuranceResult": { "const": "ASSURANCE_COMPLETE" },
    "reasonCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "issuedAt": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128 }
  },
  "required": ["commandId", "decisionCaseId", "applicationId", "decisionId", "evaluationRunId", "evaluationRunStatus", "finalDecision", "assuranceResult"],
  "additionalProperties": false
}
