{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/mock/mock-evaluation-result.v1.0.0.schema.json",
  "title": "Phase 1 Mock Evaluation Result",
  "description": "Deterministic Phase 1 proposal awaiting Governance verification. It is never a final loan decision and cannot directly mutate Loan Application state.",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "decisionId": { "type": "string", "format": "uuid" },
    "evaluationRunId": { "type": "string", "format": "uuid" },
    "decisionCaseId": { "type": "string", "minLength": 1 },
    "proposal": { "type": "string", "enum": ["MOCK_APPROVE", "MOCK_CONDITIONAL_APPROVE", "MOCK_MORE_EVIDENCE", "MOCK_REJECT"] },
    "reasonCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "inputSnapshotVersion": { "type": "string", "minLength": 1 },
    "mockRuleVersion": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" }
  },
  "required": ["schemaVersion", "decisionId", "evaluationRunId", "decisionCaseId", "proposal", "reasonCodes", "inputSnapshotVersion", "mockRuleVersion", "createdAt"],
  "additionalProperties": false
}
