{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/mock/mock-assurance-result.v1.0.0.schema.json",
  "title": "Phase 1 Mock Assurance Result",
  "description": "Minimal deterministic Phase 1 assurance result; this is neither an Assurance Profile nor an OPA Policy Input.",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "evaluationRunId": { "type": "string", "format": "uuid" },
    "status": { "type": "string", "enum": ["ASSURANCE_COMPLETE", "ASSURANCE_INCOMPLETE", "ASSURANCE_VIOLATED"] },
    "reasonCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "sourceDecisionId": { "type": "string", "format": "uuid" },
    "assessedAt": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" }
  },
  "required": ["schemaVersion", "evaluationRunId", "status", "reasonCodes", "sourceDecisionId", "assessedAt"],
  "additionalProperties": false
}
