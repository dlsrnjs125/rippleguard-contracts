{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/rest/loan-application.v1.0.0.schema.json",
  "title": "Loan Application",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "applicationId": { "type": "string", "format": "uuid" },
    "status": { "$ref": "../domain/loan-application-status.v1.0.0.schema.json" },
    "snapshotVersion": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "updatedAt": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" }
  },
  "required": ["schemaVersion", "applicationId", "status", "snapshotVersion", "createdAt", "updatedAt"],
  "additionalProperties": false
}
