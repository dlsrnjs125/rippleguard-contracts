{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/rest/case-timeline.v1.0.0.schema.json",
  "title": "Case Timeline",
  "description": "Minimal Phase 1 audit read model. It is not a replay, execution graph, or hash-chain contract.",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "caseId": { "type": "string", "minLength": 1 },
    "applicationId": { "type": "string", "format": "uuid" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": { "type": "string", "format": "uuid" },
          "eventType": { "type": "string", "minLength": 1 },
          "caseId": { "type": "string", "minLength": 1 },
          "occurredAt": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
          "producer": { "type": "string", "minLength": 1 },
          "evaluationRunId": { "type": ["string", "null"], "format": "uuid" },
          "correlationId": { "type": "string", "minLength": 1 },
          "causationId": { "type": ["string", "null"], "format": "uuid" },
          "status": { "type": "string", "enum": ["RECORDED", "LATE", "DUPLICATE", "INVALID_REFERENCE"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "required": ["eventId", "eventType", "caseId", "occurredAt", "producer", "evaluationRunId", "correlationId", "causationId", "status", "summary"],
        "additionalProperties": false
      }
    },
    "traceCompleteness": { "type": "string", "enum": ["COMPLETE", "PARTIAL", "UNKNOWN"] },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "required": ["schemaVersion", "caseId", "applicationId", "events", "traceCompleteness", "warnings"],
  "additionalProperties": false
}
