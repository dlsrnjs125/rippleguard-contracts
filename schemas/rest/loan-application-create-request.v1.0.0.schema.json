{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/rest/loan-application-create-request.v1.0.0.schema.json",
  "title": "Loan Application Create Request",
  "description": "Phase 1 loan submission. applicantReference and all evidence references must point to synthetic or masked data; raw personal data is outside this contract.",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "applicantReference": { "type": "string", "pattern": "^(synthetic|masked):[A-Za-z0-9._-]+$" },
    "requestedAmount": { "$ref": "#/$defs/positiveMoney" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "incomeHistory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "period": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
          "amount": { "$ref": "#/$defs/money" },
          "sourceReference": { "type": "string", "pattern": "^(synthetic|masked):[A-Za-z0-9._-]+$" }
        },
        "required": ["period", "amount", "sourceReference"],
        "additionalProperties": false
      }
    },
    "debtSummary": {
      "type": "object",
      "properties": {
        "totalOutstandingAmount": { "$ref": "#/$defs/money" },
        "monthlyPaymentAmount": { "$ref": "#/$defs/money" },
        "sourceReferences": { "$ref": "#/$defs/references" }
      },
      "required": ["totalOutstandingAmount", "monthlyPaymentAmount", "sourceReferences"],
      "additionalProperties": false
    },
    "delinquencySummary": {
      "type": "object",
      "properties": {
        "delinquencyCount": { "type": "integer", "minimum": 0 },
        "daysPastDueMaximum": { "type": "integer", "minimum": 0 },
        "sourceReferences": { "$ref": "#/$defs/references" }
      },
      "required": ["delinquencyCount", "daysPastDueMaximum", "sourceReferences"],
      "additionalProperties": false
    },
    "platformSettlementSummary": {
      "type": "object",
      "properties": {
        "period": { "type": "string", "minLength": 1 },
        "grossSettlementAmount": { "$ref": "#/$defs/money" },
        "sourceReferences": { "$ref": "#/$defs/references" }
      },
      "required": ["period", "grossSettlementAmount", "sourceReferences"],
      "additionalProperties": false
    },
    "riskSignalReferences": { "$ref": "#/$defs/references" },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128 }
  },
  "$defs": {
    "money": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$",
      "description": "Exact decimal amount with at most two fractional digits; never a binary floating-point JSON number."
    },
    "positiveMoney": {
      "type": "string",
      "pattern": "^(?=.*[1-9])(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(synthetic|masked):[A-Za-z0-9._-]+$" }
    }
  },
  "required": ["schemaVersion", "applicantReference", "requestedAmount", "currency", "incomeHistory", "debtSummary", "delinquencySummary", "platformSettlementSummary", "riskSignalReferences", "idempotencyKey"],
  "additionalProperties": false
}
