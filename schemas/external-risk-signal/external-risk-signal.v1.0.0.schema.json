{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/external-risk-signal/external-risk-signal.v1.0.0.schema.json",
  "title": "External Risk Signal",
  "description": "Purpose-bound signal supplied by an FDS Simulator. A suspected transaction anomaly is not a confirmed fact about the customer and must not be promoted into customer credit risk.",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "riskSignalId": { "type": "string", "format": "uuid" },
    "sourceSystem": { "type": "string", "minLength": 1 },
    "originalPurpose": { "type": "string", "enum": ["FRAUD_DETECTION"] },
    "subjectType": { "type": "string", "enum": ["TRANSACTION", "CUSTOMER"], "description": "TRANSACTION scopes a signal to one transaction; CUSTOMER represents a customer-level fact only when separately confirmed." },
    "subjectId": { "type": "string", "minLength": 1 },
    "inferenceStatus": { "type": "string", "enum": ["SUSPECTED", "CONFIRMED"], "description": "SUSPECTED is an unconfirmed anomaly and never asserts a confirmed customer fact." },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "occurredAt": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "validUntil": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "permittedUses": { "type": "array", "items": { "type": "string", "enum": ["FRAUD_REVIEW", "IDENTITY_VERIFICATION", "MANUAL_REVIEW_ROUTING", "CUSTOMER_CREDIT_RISK_ASSESSMENT"] }, "minItems": 1, "uniqueItems": true },
    "prohibitedUses": { "type": "array", "items": { "type": "string", "enum": ["AUTOMATIC_LOAN_REJECTION", "CUSTOMER_CREDIT_RISK_ASSESSMENT", "CUSTOMER_RISK_CLASSIFICATION"] }, "minItems": 1, "uniqueItems": true },
    "reasonCodes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }
  },
  "required": ["schemaVersion", "riskSignalId", "sourceSystem", "originalPurpose", "subjectType", "subjectId", "inferenceStatus", "confidence", "occurredAt", "validUntil", "permittedUses", "prohibitedUses", "reasonCodes"],
  "allOf": [
    {
      "if": { "properties": { "inferenceStatus": { "const": "SUSPECTED" } }, "required": ["inferenceStatus"] },
      "then": {
        "properties": {
          "subjectType": { "const": "TRANSACTION" },
          "permittedUses": { "not": { "contains": { "const": "CUSTOMER_CREDIT_RISK_ASSESSMENT" } } },
          "prohibitedUses": { "contains": { "const": "CUSTOMER_CREDIT_RISK_ASSESSMENT" } }
        }
      }
    }
  ],
  "additionalProperties": false
}
