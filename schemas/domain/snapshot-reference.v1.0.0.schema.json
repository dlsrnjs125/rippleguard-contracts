{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/domain/snapshot-reference.v1.0.0.schema.json",
  "title": "Versioned Snapshot Reference",
  "description": "Immutable reference to a Loan financial Snapshot. Mutable URLs alone are not sufficient identity.",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "snapshotId": { "type": "string", "minLength": 1 },
    "snapshotVersion": { "type": "string", "minLength": 1 },
    "snapshotSchemaVersion": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
    "snapshotCreatedAt": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "digestAlgorithm": { "const": "sha256" },
    "snapshotDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "snapshotReference": { "type": "string", "pattern": "^(snapshot|s3|minio)://.+" },
    "referenceType": { "type": "string", "enum": ["IMMUTABLE_REFERENCE", "MATERIALIZED_FEATURES"] }
  },
  "required": ["schemaVersion", "snapshotId", "snapshotVersion", "snapshotSchemaVersion", "snapshotCreatedAt", "digestAlgorithm", "snapshotDigest", "snapshotReference", "referenceType"],
  "additionalProperties": false
}
