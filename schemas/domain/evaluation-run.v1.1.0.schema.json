{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/domain/evaluation-run.v1.1.0.schema.json",
  "title": "Evaluation Run",
  "description": "Backward-compatible Phase 1 extension recording completion time. Recalculation creates a new run and preserves the superseded result.",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "evaluationRunId": { "type": "string", "format": "uuid" },
    "decisionCaseId": { "type": "string", "minLength": 1 },
    "inputSnapshotVersion": { "type": "string", "minLength": 1 },
    "executionPlanVersion": { "type": "string", "minLength": 1 },
    "componentVersions": {
      "type": "array",
      "description": "Complete model, prompt, tool, and agent provenance; Phase 1 mock components use explicit deterministic versions.",
      "items": {
        "type": "object",
        "properties": {
          "componentType": { "type": "string", "enum": ["MODEL", "PROMPT", "TOOL", "AGENT"] },
          "componentName": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        },
        "required": ["componentType", "componentName", "version"],
        "additionalProperties": false
      },
      "minItems": 4,
      "uniqueItems": true,
      "allOf": [
        { "contains": { "properties": { "componentType": { "const": "MODEL" } }, "required": ["componentType"] }, "minContains": 1 },
        { "contains": { "properties": { "componentType": { "const": "PROMPT" } }, "required": ["componentType"] }, "minContains": 1 },
        { "contains": { "properties": { "componentType": { "const": "TOOL" } }, "required": ["componentType"] }, "minContains": 1 },
        { "contains": { "properties": { "componentType": { "const": "AGENT" } }, "required": ["componentType"] }, "minContains": 1 }
      ]
    },
    "policyInputVersion": { "type": "string", "minLength": 1, "description": "Phase 1 may use an explicit no-OPA marker." },
    "policyBundleVersion": { "type": "string", "minLength": 1, "description": "Phase 1 may use phase1-no-opa." },
    "status": { "type": "string", "enum": ["CREATED", "RUNNING", "COMPLETED", "BLOCKED", "FAILED", "CANCELLED"] },
    "supersedesRunId": { "type": ["string", "null"], "format": "uuid" },
    "createdAt": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "completedAt": { "type": ["string", "null"], "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$", "description": "Completion time for a terminal run; null while the run is CREATED or RUNNING." }
  },
  "required": ["schemaVersion", "evaluationRunId", "decisionCaseId", "inputSnapshotVersion", "executionPlanVersion", "componentVersions", "policyInputVersion", "policyBundleVersion", "status", "supersedesRunId", "createdAt"],
  "additionalProperties": false
}
