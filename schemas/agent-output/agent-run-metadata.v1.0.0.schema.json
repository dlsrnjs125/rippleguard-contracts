{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/agent-output/agent-run-metadata.v1.0.0.schema.json",
  "title": "Agent Run Metadata",
  "description": "Identity and attempt metadata for a Phase 2 Loan Decision Agent run.",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "decisionCaseId": { "type": "string", "minLength": 1 },
    "evaluationRunId": { "type": "string", "format": "uuid" },
    "agentRunId": { "type": "string", "format": "uuid" },
    "attemptId": { "type": "integer", "minimum": 1 },
    "agentType": { "const": "LOAN_DECISION_AGENT" },
    "requestIdempotencyKey": { "type": "string", "minLength": 16, "maxLength": 160 },
    "startedAt": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "completedAt": { "type": ["string", "null"], "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "runtimeVersion": { "type": "string", "minLength": 1 }
  },
  "required": ["schemaVersion", "decisionCaseId", "evaluationRunId", "agentRunId", "attemptId", "agentType", "requestIdempotencyKey", "startedAt", "completedAt", "runtimeVersion"],
  "additionalProperties": false
}
