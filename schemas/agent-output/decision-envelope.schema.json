{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/agent-output/decision-envelope.schema.json",
  "title": "Decision Envelope",
  "description": "A versioned evaluation proposal for Governance review. This is not a final loan outcome and cannot directly mutate Loan Application status.",
  "type": "object",
  "properties": {
    "decisionId": { "type": "string", "format": "uuid" },
    "evaluationRunId": { "type": "string", "format": "uuid" },
    "decisionCaseId": { "type": "string", "minLength": 1 },
    "producer": { "type": "string", "minLength": 1 },
    "originalPurpose": { "type": "string", "minLength": 1 },
    "subjectType": { "type": "string", "enum": ["LOAN_APPLICATION"] },
    "proposal": { "type": "string", "enum": ["PROPOSE_APPROVE", "PROPOSE_CONDITIONAL_APPROVE", "PROPOSE_MORE_EVIDENCE", "PROPOSE_REJECT"] },
    "status": { "type": "string", "enum": ["PROPOSED"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "usedEvidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "modelVersion": { "type": "string", "minLength": 1 },
    "promptVersion": { "type": "string", "minLength": 1 },
    "validUntil": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" }
  },
  "required": ["decisionId", "evaluationRunId", "decisionCaseId", "producer", "originalPurpose", "subjectType", "proposal", "status", "confidence", "usedEvidenceRefs", "modelVersion", "promptVersion", "validUntil"],
  "additionalProperties": false
}
