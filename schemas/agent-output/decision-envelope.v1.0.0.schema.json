{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/agent-output/decision-envelope.v1.0.0.schema.json",
  "title": "Decision Envelope",
  "description": "A versioned evaluation proposal for Governance review. evaluatorId and generatorRef identify logical evaluation provenance, not the publishing service. This is not a final loan outcome and cannot directly mutate Loan Application status.",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "decisionId": { "type": "string", "format": "uuid" },
    "evaluationRunId": { "type": "string", "format": "uuid" },
    "decisionCaseId": { "type": "string", "minLength": 1 },
    "evaluatorId": { "type": "string", "minLength": 1, "description": "Logical evaluator that generated the proposal; this is not a service identity." },
    "originalPurpose": { "type": "string", "minLength": 1 },
    "subjectType": { "type": "string", "enum": ["LOAN_APPLICATION"] },
    "proposal": { "type": "string", "enum": ["PROPOSE_APPROVE", "PROPOSE_CONDITIONAL_APPROVE", "PROPOSE_MORE_EVIDENCE", "PROPOSE_REJECT"] },
    "status": { "type": "string", "enum": ["PROPOSED"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "usedEvidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "generatorRef": {
      "type": "object",
      "description": "Named Agent, Model, and Prompt provenance that must exist in the referenced Evaluation Run componentVersions.",
      "properties": {
        "agentName": { "type": "string", "minLength": 1 },
        "agentVersion": { "type": "string", "minLength": 1 },
        "modelName": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "promptName": { "type": "string", "minLength": 1 },
        "promptVersion": { "type": "string", "minLength": 1 }
      },
      "required": ["agentName", "agentVersion", "modelName", "modelVersion", "promptName", "promptVersion"],
      "additionalProperties": false
    },
    "validUntil": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" }
  },
  "required": ["schemaVersion", "decisionId", "evaluationRunId", "decisionCaseId", "evaluatorId", "originalPurpose", "subjectType", "proposal", "status", "confidence", "usedEvidenceRefs", "generatorRef", "validUntil"],
  "additionalProperties": false
}
