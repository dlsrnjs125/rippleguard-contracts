{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/agent-output/loan-proposal.v1.0.0.schema.json",
  "title": "Loan Proposal",
  "description": "Model-generated non-final recommendation. This is not a Loan status, final approval, policy decision, or human decision.",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "proposalId": { "type": "string", "format": "uuid" },
    "proposalOutcome": {
      "type": "string",
      "enum": [
        "RECOMMEND_APPROVAL",
        "RECOMMEND_CONDITIONAL_REVIEW",
        "RECOMMEND_ADDITIONAL_EVIDENCE",
        "RECOMMEND_DECLINE"
      ]
    },
    "repaymentLikelihoodScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "scoreSemantics": { "const": "higher score means higher repayment likelihood" },
    "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "thresholdVersion": { "type": "string", "minLength": 1 },
    "comparisonDirection": { "const": "score_greater_than_or_equal_threshold_supports_approval" },
    "reasonCodes": {
      "type": "array",
      "items": { "type": "string", "enum": ["LOW_DTI", "STABLE_INCOME", "HIGH_DTI", "RECENT_DELINQUENCY", "INSUFFICIENT_HISTORY", "VOLATILE_SETTLEMENTS"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "modelVersion": { "type": "string", "minLength": 1 },
    "featureSchemaVersion": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" }
  },
  "required": ["schemaVersion", "proposalId", "proposalOutcome", "repaymentLikelihoodScore", "scoreSemantics", "threshold", "thresholdVersion", "comparisonDirection", "reasonCodes", "modelVersion", "featureSchemaVersion", "generatedAt"],
  "additionalProperties": false
}
