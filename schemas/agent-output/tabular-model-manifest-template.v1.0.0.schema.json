{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/agent-output/tabular-model-manifest-template.v1.0.0.schema.json",
  "title": "Tabular Model Manifest Template",
  "description": "Source-controlled Phase 2 model manifest template. This is not release evidence; Infra materializes a published tabular-model-manifest.v1.0.0 with the exact runtime image digest after image build.",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "modelType": { "const": "TABULAR" },
    "manifestPublicationState": { "const": "TEMPLATE" },
    "modelName": { "type": "string", "minLength": 1 },
    "modelVersion": { "type": "string", "minLength": 1 },
    "framework": { "type": "string", "enum": ["xgboost", "lightgbm"] },
    "frameworkVersion": { "type": "string", "minLength": 1 },
    "featureSchemaVersion": { "type": "string", "minLength": 1 },
    "preprocessingVersion": { "type": "string", "minLength": 1 },
    "trainingDatasetReference": { "type": "string", "minLength": 1 },
    "trainingDatasetDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "evaluationDatasetVersion": { "type": "string", "minLength": 1 },
    "evaluationDatasetDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "trainingCodeCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "randomSeed": { "type": "integer", "minimum": 0 },
    "thresholdVersion": { "type": "string", "minLength": 1 },
    "modelBinaryArtifactReference": { "type": "string", "pattern": "^(file|minio|s3)://.+" },
    "artifactDigestAlgorithm": { "const": "sha256" },
    "modelBinaryArtifactDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "modelFormat": { "type": "string", "enum": ["xgboost-json", "lightgbm-text", "onnx"] },
    "targetDefinition": { "type": "string", "minLength": 1 },
    "scoreSemantics": { "const": "higher score means higher repayment likelihood" },
    "selectedMetrics": {
      "type": "object",
      "properties": {
        "primary": { "type": "string", "enum": ["PR_AUC", "ROC_AUC"] },
        "guardrail": { "const": "RECALL_AT_FIXED_APPROVAL_RISK_THRESHOLD" },
        "calibration": { "type": "string", "enum": ["BRIER_SCORE", "EXPECTED_CALIBRATION_ERROR"] }
      },
      "required": ["primary", "guardrail", "calibration"],
      "additionalProperties": false
    },
    "shapExplainerVersion": { "type": "string", "minLength": 1 },
    "shapExplainerConfig": { "type": "object", "minProperties": 1, "additionalProperties": { "type": ["string", "number", "boolean"] } },
    "pythonVersion": { "type": "string", "minLength": 1 },
    "runtimeImageDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Optional unresolved build-time placeholder retained only for transition from existing source manifests. Published release evidence must use tabular-model-manifest.v1.0.0."
    },
    "platformArchitecture": { "type": "string", "enum": ["linux/amd64", "linux/arm64", "darwin/arm64"] },
    "threadCount": { "type": "integer", "minimum": 1 },
    "deterministicConfig": { "type": "string", "minLength": 1 },
    "dependencyLockDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "license": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "format": "uri" },
    "createdAt": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" }
  },
  "required": ["schemaVersion", "modelType", "manifestPublicationState", "modelName", "modelVersion", "framework", "frameworkVersion", "featureSchemaVersion", "preprocessingVersion", "trainingDatasetReference", "trainingDatasetDigest", "evaluationDatasetVersion", "evaluationDatasetDigest", "trainingCodeCommit", "randomSeed", "thresholdVersion", "modelBinaryArtifactReference", "artifactDigestAlgorithm", "modelBinaryArtifactDigest", "modelFormat", "targetDefinition", "scoreSemantics", "selectedMetrics", "shapExplainerVersion", "shapExplainerConfig", "pythonVersion", "platformArchitecture", "threadCount", "deterministicConfig", "dependencyLockDigest", "license", "source", "createdAt"],
  "allOf": [
    {
      "if": {
        "properties": { "framework": { "const": "xgboost" } },
        "required": ["framework"]
      },
      "then": {
        "properties": { "modelFormat": { "enum": ["xgboost-json", "onnx"] } }
      }
    },
    {
      "if": {
        "properties": { "framework": { "const": "lightgbm" } },
        "required": ["framework"]
      },
      "then": {
        "properties": { "modelFormat": { "enum": ["lightgbm-text", "onnx"] } }
      }
    }
  ],
  "additionalProperties": false
}
