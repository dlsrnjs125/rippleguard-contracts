{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/agent-output/loan-decision-agent-result.v1.0.0.schema.json",
  "title": "Loan Decision Agent Result",
  "description": "Agent Runtime result returned only to Governance. Completed and failed variants are exclusive.",
  "type": "object",
  "oneOf": [
    {
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "resultStatus": { "const": "COMPLETED" },
        "agentRun": { "$ref": "agent-run-metadata.v1.0.0.schema.json" },
        "snapshotReference": { "$ref": "../domain/snapshot-reference.v1.0.0.schema.json" },
        "featureSchemaVersion": { "type": "string", "minLength": 1 },
        "preprocessingVersion": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "modelArtifactDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "thresholdVersion": { "type": "string", "minLength": 1 },
        "proposal": { "$ref": "loan-proposal.v1.0.0.schema.json" },
        "explanationRef": { "type": "string", "pattern": "^(shap|artifact)://.+" },
        "explanationDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "completedAt": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" }
      },
      "required": ["schemaVersion", "resultStatus", "agentRun", "snapshotReference", "featureSchemaVersion", "preprocessingVersion", "modelVersion", "modelArtifactDigest", "thresholdVersion", "proposal", "explanationRef", "explanationDigest", "evidenceRefs", "completedAt"],
      "additionalProperties": false
    },
    {
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "resultStatus": { "const": "FAILED" },
        "agentRun": { "$ref": "agent-run-metadata.v1.0.0.schema.json" },
        "snapshotReference": { "$ref": "../domain/snapshot-reference.v1.0.0.schema.json" },
        "featureSchemaVersion": { "type": "string", "minLength": 1 },
        "preprocessingVersion": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "modelArtifactDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "thresholdVersion": { "type": "string", "minLength": 1 },
        "failure": {
          "type": "object",
          "properties": {
            "classification": { "type": "string", "enum": ["RETRYABLE", "NON_RETRYABLE", "VALIDATION_REQUIRED", "BLOCKED"] },
            "reasonCode": {
              "type": "string",
              "enum": [
                "FEATURE_SCHEMA_VERSION_UNSUPPORTED",
                "FEATURE_REQUIRED_MISSING",
                "FEATURE_UNKNOWN",
                "FEATURE_TYPE_INVALID",
                "FEATURE_VALUE_OUT_OF_RANGE",
                "SNAPSHOT_NOT_FOUND",
                "SNAPSHOT_LOOKUP_TEMPORARY_FAILURE",
                "SNAPSHOT_DIGEST_MISMATCH",
                "SNAPSHOT_SCHEMA_UNSUPPORTED",
                "MODEL_MANIFEST_NOT_FOUND",
                "MODEL_ARTIFACT_NOT_FOUND",
                "MODEL_ARTIFACT_DIGEST_MISMATCH",
                "MODEL_VERSION_UNSUPPORTED",
                "AGENT_TIMEOUT",
                "AGENT_RUNTIME_TEMPORARY_FAILURE",
                "RETRY_EXHAUSTED",
                "DUPLICATE_REQUEST",
                "AGENT_RUN_INPUT_CONFLICT",
                "AGENT_RUN_RESULT_CONFLICT",
                "SHAP_CALCULATION_FAILED",
                "CONTRACT_VALIDATION_FAILED",
                "AUDIT_PUBLICATION_FAILED"
              ]
            },
            "safeMessage": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          "required": ["classification", "reasonCode", "safeMessage"],
          "additionalProperties": false
        },
        "completedAt": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" }
      },
      "required": ["schemaVersion", "resultStatus", "agentRun", "snapshotReference", "featureSchemaVersion", "preprocessingVersion", "modelVersion", "modelArtifactDigest", "thresholdVersion", "failure", "completedAt"],
      "additionalProperties": false
    }
  ]
}
