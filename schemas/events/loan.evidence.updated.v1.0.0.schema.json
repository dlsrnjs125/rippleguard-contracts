{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/events/loan.evidence.updated.v1.0.0.schema.json",
  "title": "Loan Evidence Updated v1.0.0",
  "allOf": [
    { "$ref": "../common/event-envelope.schema.json" },
    {
      "properties": {
        "producer": { "const": "loan-service" },
        "eventType": { "const": "loan.evidence.updated.v1" },
        "schemaVersion": { "const": "1.0.0" },
        "causationId": { "type": "string", "format": "uuid" },
        "payload": {
          "type": "object",
          "properties": {
            "applicationId": { "type": "string", "minLength": 1 },
            "decisionCaseId": { "type": "string", "minLength": 1 },
            "inputSnapshotVersion": { "type": "string", "minLength": 1 },
            "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }
          },
          "required": ["applicationId", "decisionCaseId", "inputSnapshotVersion", "evidenceRefs"],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
