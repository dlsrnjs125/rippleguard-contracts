{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/events/governance.review.started.v1.1.0.schema.json",
  "title": "Governance Review Started v1.1.0",
  "allOf": [
    { "$ref": "../common/phase-1-event-envelope-profile.v1.0.0.schema.json" },
    {
      "properties": {
        "producer": { "const": "governance-service" },
        "eventType": { "const": "governance.review.started.v1" },
        "schemaVersion": { "const": "1.1.0" },
        "causationId": { "type": "string", "format": "uuid" },
        "payload": {
          "type": "object",
          "properties": {
            "decisionCaseId": { "type": "string", "minLength": 1 },
            "applicationId": { "type": "string", "format": "uuid" },
            "reviewStartedAt": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" }
          },
          "required": ["decisionCaseId", "applicationId", "reviewStartedAt"],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
