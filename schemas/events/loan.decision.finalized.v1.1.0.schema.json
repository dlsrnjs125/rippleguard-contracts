{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/events/loan.decision.finalized.v1.1.0.schema.json",
  "title": "Loan Decision Finalized v1.1.0",
  "allOf": [
    { "$ref": "../common/phase-1-event-envelope-profile.v1.0.0.schema.json" },
    {
      "properties": {
        "producer": { "const": "loan-service" },
        "eventType": { "const": "loan.decision.finalized.v1" },
        "schemaVersion": { "const": "1.1.0" },
        "causationId": { "type": "string", "format": "uuid" },
        "payload": {
          "type": "object",
          "properties": {
            "commandId": { "type": "string", "format": "uuid" },
            "decisionCaseId": { "type": "string", "minLength": 1 },
            "applicationId": { "type": "string", "format": "uuid" },
            "decisionId": { "type": "string", "format": "uuid" },
            "evaluationRunId": { "type": "string", "format": "uuid" },
            "finalDecision": { "type": "string", "enum": ["APPROVE", "REJECT"] },
            "finalizedAt": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" }
          },
          "required": ["commandId", "decisionCaseId", "applicationId", "decisionId", "evaluationRunId", "finalDecision", "finalizedAt"],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
