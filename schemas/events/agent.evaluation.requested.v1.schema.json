{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/events/agent.evaluation.requested.v1.schema.json",
  "title": "Agent Evaluation Requested v1",
  "description": "Implementation-neutral request supporting both Phase 1 mock evaluation and later agent execution.",
  "allOf": [
    { "$ref": "../common/event-envelope.schema.json" },
    {
      "properties": {
        "eventType": { "const": "agent.evaluation.requested.v1" },
        "schemaVersion": { "const": "1.0.0" },
        "payload": {
          "type": "object",
          "properties": {
            "evaluationRunId": { "type": "string", "format": "uuid" },
            "decisionCaseId": { "type": "string", "minLength": 1 },
            "inputSnapshotVersion": { "type": "string", "minLength": 1 },
            "executionPlanVersion": { "type": "string", "minLength": 1 },
            "evaluationMode": { "type": "string", "enum": ["MOCK", "AGENT"] }
          },
          "required": ["evaluationRunId", "decisionCaseId", "inputSnapshotVersion", "executionPlanVersion", "evaluationMode"],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
