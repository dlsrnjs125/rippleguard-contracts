{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/events/loan.application.submitted.v1.1.0.schema.json",
  "title": "Loan Application Submitted v1.1.0",
  "description": "Backward-compatible minor version adding an optional submissionChannel field.",
  "allOf": [
    { "$ref": "../common/phase-1-event-envelope-profile.v1.0.0.schema.json" },
    {
      "properties": {
        "producer": { "const": "loan-service" },
        "eventType": { "const": "loan.application.submitted.v1" },
        "schemaVersion": { "const": "1.1.0" },
        "causationId": { "const": null, "description": "The root application event has no preceding event." },
        "payload": {
          "type": "object",
          "properties": {
            "applicationId": { "type": "string", "format": "uuid" },
            "applicantId": { "type": "string", "minLength": 1 },
            "inputSnapshotVersion": { "type": "string", "minLength": 1 },
            "submittedAt": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
            "submissionChannel": { "type": "string", "enum": ["WEB", "BRANCH", "PARTNER_API"] }
          },
          "required": ["applicationId", "applicantId", "inputSnapshotVersion", "submittedAt"],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
