{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rippleguard.dev/events/governance.agent-result.validated.v2.0.0.schema.json",
  "title": "Governance Agent Result Validated v2.0.0",
  "description": "Provenance-complete Governance-owned audit event emitted after validating a Phase 2 Agent result. The causationId must reference the persisted agent.evaluation.requested.v1 event.",
  "allOf": [
    { "$ref": "../common/phase-1-event-envelope-profile.v1.0.0.schema.json" },
    {
      "properties": {
        "producer": { "const": "governance-service" },
        "eventType": { "const": "governance.agent-result.validated.v2" },
        "schemaVersion": { "const": "2.0.0" },
        "causationId": { "type": "string", "format": "uuid" },
        "payload": {
          "type": "object",
          "properties": {
            "decisionCaseId": { "type": "string", "minLength": 1 },
            "evaluationRunId": { "type": "string", "format": "uuid" },
            "agentRunId": { "type": "string", "format": "uuid" },
            "attemptId": { "type": "integer", "minimum": 1 },
            "validationOutcome": { "type": "string", "enum": ["VALIDATED", "REJECTED"] },
            "validationReasonCodes": {
              "type": "array",
              "items": { "type": "string", "enum": ["SCHEMA_VALID", "SCHEMA_INVALID", "MODEL_PROVENANCE_VALID", "MODEL_PROVENANCE_INVALID", "SNAPSHOT_MATCHED", "SNAPSHOT_MISMATCH", "SHAP_PRESENT", "SHAP_MISSING", "AGENT_FAILURE_RECORDED"] },
              "minItems": 1,
              "uniqueItems": true
            },
            "snapshotId": { "type": "string", "minLength": 1 },
            "snapshotVersion": { "type": "string", "minLength": 1 },
            "snapshotSchemaVersion": { "type": "string", "minLength": 1 },
            "snapshotDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "featureSchemaVersion": { "type": "string", "minLength": 1 },
            "preprocessingVersion": { "type": "string", "minLength": 1 },
            "modelVersion": { "type": "string", "minLength": 1 },
            "modelArtifactDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "thresholdVersion": { "type": "string", "minLength": 1 },
            "agentResultReference": { "type": "string", "pattern": "^agent-result://.+" },
            "agentResultDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "requestEventId": { "type": "string", "format": "uuid" },
            "validatedAt": { "type": "string", "format": "date-time", "pattern": "T.*(?:Z|[+-][0-9]{2}:[0-9]{2})$" }
          },
          "required": ["decisionCaseId", "evaluationRunId", "agentRunId", "attemptId", "validationOutcome", "validationReasonCodes", "snapshotId", "snapshotVersion", "snapshotSchemaVersion", "snapshotDigest", "featureSchemaVersion", "preprocessingVersion", "modelVersion", "modelArtifactDigest", "thresholdVersion", "requestEventId", "validatedAt"],
          "additionalProperties": false,
          "oneOf": [
            {
              "required": ["agentResultReference", "agentResultDigest"],
              "properties": {
                "validationOutcome": { "const": "VALIDATED" },
                "validationReasonCodes": {
                  "allOf": [
                    { "contains": { "const": "SCHEMA_VALID" } },
                    { "contains": { "const": "MODEL_PROVENANCE_VALID" } },
                    { "contains": { "const": "SNAPSHOT_MATCHED" } },
                    { "contains": { "const": "SHAP_PRESENT" } },
                    { "not": { "contains": { "enum": ["SCHEMA_INVALID", "MODEL_PROVENANCE_INVALID", "SNAPSHOT_MISMATCH", "SHAP_MISSING", "AGENT_FAILURE_RECORDED"] } } }
                  ]
                }
              }
            },
            {
              "required": ["agentResultReference", "agentResultDigest"],
              "properties": {
                "validationOutcome": { "const": "REJECTED" },
                "validationReasonCodes": {
                  "contains": { "enum": ["SCHEMA_INVALID", "MODEL_PROVENANCE_INVALID", "SNAPSHOT_MISMATCH", "SHAP_MISSING"] },
                  "not": {
                    "allOf": [
                      { "contains": { "const": "SCHEMA_VALID" } },
                      { "contains": { "const": "MODEL_PROVENANCE_VALID" } },
                      { "contains": { "const": "SNAPSHOT_MATCHED" } },
                      { "contains": { "const": "SHAP_PRESENT" } }
                    ]
                  }
                }
              }
            },
            {
              "not": {
                "anyOf": [
                  { "required": ["agentResultReference"] },
                  { "required": ["agentResultDigest"] }
                ]
              },
              "properties": {
                "validationOutcome": { "const": "REJECTED" },
                "validationReasonCodes": {
                  "contains": { "const": "AGENT_FAILURE_RECORDED" },
                  "not": {
                    "contains": { "enum": ["SCHEMA_INVALID", "MODEL_PROVENANCE_INVALID", "SNAPSHOT_MISMATCH", "SHAP_MISSING", "SCHEMA_VALID", "MODEL_PROVENANCE_VALID", "SNAPSHOT_MATCHED", "SHAP_PRESENT"] }
                  }
                }
              }
            }
          ]
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
